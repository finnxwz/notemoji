{
	"name": "notemoji",
	"version": "1.0.1",
	"description": "Emoji for notes and folders: in the file explorer, above the note title and in tabs. Stored in the note's frontmatter.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings 0 .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "prettier --check . && eslint --max-warnings 0 . && tsc --noEmit && vitest run && node esbuild.config.mjs production",
		"emoji-data": "node scripts/generate-emoji-data.mjs",
		"demo": "node scripts/record-demo.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"emoji",
		"icons",
		"file-explorer"
	],
	"author": "Finn-Christopher",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.10.0",
		"emojibase-data": "^18.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"happy-dom": "^21.0.3",
		"obsidian": "^1.7.2",
		"playwright-core": "^1.64.1",
		"prettier": "^3.9.10",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
